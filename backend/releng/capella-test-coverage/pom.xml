<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.capella</groupId>
        <artifactId>capella-parent</artifactId>
        <version>2026.7.0</version>
        <relativePath>../../releng/capella-parent</relativePath> <!-- lookup parent from repository -->
    </parent>

    <artifactId>capella-test-coverage</artifactId>
	<name>capella-test-coverage</name>
    <description>Capella test coverage</description>
	<packaging>pom</packaging>

	<dependencies>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-application</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-application-configuration</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-model-services</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-diagram-common-view</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-diagram-lab-view</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-diagram-oab-view</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-diagram-ocb-view</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-diagram-sab-view</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-table-view</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-form-view</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-ddv-view</artifactId>
			<version>2026.7.0</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<executions>
					<execution>
						<id>test-report</id>
						<phase>verify</phase>
						<goals>
							<goal>report-aggregate</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
