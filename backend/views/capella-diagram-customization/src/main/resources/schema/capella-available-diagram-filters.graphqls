extend type RepresentationMetadata {
    availableDiagramFilters : [ CapellaDiagramFilter! ]!
}

type CapellaDiagramFilter {
    id: String # this is not a UUID, it should be human-readable
    label: String
    state: Boolean
    activeTooltip : String
    inactiveTooltip : String
    urlParam : String
}

extend type Viewer {
    diagramFilterState(diagramFilterId: String!) : Boolean!
}

extend type Mutation {
    setDiagramFilterState(input: SetDiagramFilterStateInput!): SetDiagramFilterStatePayload!
}

input SetDiagramFilterStateInput {
    id: ID!
    editingContextId: ID!
    representationId: ID!
    filterId: String
    active: Boolean!
}

union SetDiagramFilterStatePayload = ErrorPayload | SetDiagramFilterStateSuccessPayload

type SetDiagramFilterStateSuccessPayload {
    id: ID!
    active: Boolean!
}
