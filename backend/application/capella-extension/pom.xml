<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.capella</groupId>
        <artifactId>capella-parent</artifactId>
        <version>2026.7.0</version>
        <relativePath>../../releng/capella-parent</relativePath> <!-- lookup parent from repository -->
    </parent>

    <artifactId>capella-extension</artifactId>
    <name>capella-extension</name>
    <description>Capella Extension</description>

	<dependencies>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-frontend</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-application-configuration</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-diagram-lab-view</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-diagram-oab-view</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-diagram-sab-view</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-ddv-view</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-table-view</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-form-view</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.capella</groupId>
			<artifactId>capella-model-edit</artifactId>
			<version>2026.7.0</version>
		</dependency>
		<dependency>
			<groupId>org.eclipse.syson</groupId>
			<artifactId>syson-application</artifactId>
			<version>${syson.version}</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<shadedArtifactAttached>false</shadedArtifactAttached>
							<createDependencyReducedPom>true</createDependencyReducedPom>
							<useDependencyReducedPomInJar>true</useDependencyReducedPomInJar>
							<transformers>
								<!-- Auto-configuration imports may be contributed by both SysON and Capella for SysON. -->
								<transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>META-INF/spring/org.springframework.boot.autoconfigure.AutoConfiguration.imports</resource>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.cyclonedx</groupId>
				<artifactId>cyclonedx-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
